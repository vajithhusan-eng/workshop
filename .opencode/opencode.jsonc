{
  // WORKSHOP project-level OpenCode config.
  //
  // Precedence note: discovered `.opencode/opencode.jsonc` files OVERRIDE
  // discovered direct `opencode.jsonc` files. This file therefore wins over
  // ../../opencode.jsonc (the repo root) for this project.
  //
  // Canonical full definition lives in the repo root `opencode.jsonc`.
  // Keep the two in sync - this copy exists because `.opencode/` takes
  // precedence, NOT because the settings differ.
  "$schema": "https://opencode.ai/config.json",
  "name": "WORKSHOP",
  "model": "opencode/ling-3.0-flash-fin-free",
  "default_agent": "orchestrator",
  "plugins": ["opencode-usage-quota-tracker"],
  "skills": ["~/.config/opencode/skills-active"],
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "write", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "subagent", "resource": "*", "effect": "allow" }
  ],
  // Restored. The previous copy of this file silently omitted the whole
  // compaction block, so project-level sessions ran with different
  // auto-compaction thresholds than the root config intended.
  "compaction": {
    "auto": true,
    "keep": { "tokens": 12000 },
    "buffer": 20000
  }
}