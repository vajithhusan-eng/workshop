.dart_tool/
.flutter-plugins-dependencies
.packages
**/ephemeral/

# ─── build output ───────────────────────────────────────────────
build/
dist/

# ─── databases ──────────────────────────────────────────────────
*.db
*.db-shm
*.db-wal
*.sqlite

# ─── logs ───────────────────────────────────────────────────────
*.log

# ─── tool scratch that is generated, not source ─────────────────
.playwright-mcp/
.devsup/

# Agora live-Chrome probe/run scratch. Kept on disk (another agent uses these),
# but not source. Ignoring them also shields them from a plain `git clean -fd`,
# which has destroyed untracked work in this monorepo before.
projects/agora/tool/run_*.dart
projects/agora/tool/check_load*.dart
projects/agora/tool/debug*.dart
projects/agora/tool/dbg2.dart
projects/agora/tool/probe_fix.dart

# OMNIVEST runtime state (user data, not source)
backend/omnivest_journal.json
backend/*.log

# Root-level scratch images. A screenshot belongs in the docs/ of the project it
# shows; keeping the root clean is the point, so nothing lands here by accident.
/*.png

# ─── personal agent tooling (this machine, not the projects) ────
# OpenCode config, MCP server wiring, agent definitions and the quota ledger are
# workstation setup, not product. They resolve npx cache hashes and absolute home
# paths, so they are kept on disk and out of the repository.
.opencode/
opencode.jsonc
OPENCODE_BEHAVIOR.md
push-to-github.sh
skills

