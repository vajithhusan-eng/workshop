# Multi-AI Agent Orchestrator - Environment Variables

# Application
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Server
HOST=0.0.0.0
PORT=8000
RELOAD=true

# Database
DATABASE_URL=sqlite+aiosqlite:///./sessions.db

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Playwright / Chrome
CHROMIUM_PATH=/usr/bin/chromium
HEADLESS=true

# Orchestration
MAX_AGENTS=5
MAX_ITERATIONS=10
LEADER_ELECTION_INTERVAL=5
TERMINATION_TIMEOUT=300

# Debug
DEBUG=false
