{
  "name": "workshop",
  "version": "1.0.0",
  "description": "Main project workspace",
  "private": true,
  "workspaces": ["backend", "frontend", "projects/*", "tools/*"],
  "scripts": {
    "start": "echo 'Use cd backend && ./.venv/bin/python run.py or flutter run'",
    "setup": "echo 'Setup all projects'",
    "story-app": "cd projects/story-app && make dev",
    "story-app-dev": "cd projects/story-app && make dev",
    "story-app-build": "cd projects/story-app && make build",
    "story-app-appimage": "cd projects/story-app && make appimage"
  },
  "workspacesConfig": {
    "story-app": {
      "path": "projects/story-app",
      "type": "desktop-gui",
      "framework": "flutter",
      "backend": "fastapi",
      "description": "Multi-AI Agent Orchestrator - Connect multiple AI agents via web URLs, session-based desktop app for Ubuntu Linux"
    }
  }
}
